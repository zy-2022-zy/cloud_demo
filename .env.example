# Remote Chromium CDP endpoint forwarded by the SSH tunnel
CDP_URL=http://127.0.0.1:19222

# Replace with a long random value before starting the API
API_KEY=replace-this-with-a-long-random-secret

# Keep the API bound to loopback during local development
HOST=127.0.0.1
PORT=8000

# Maximum page text returned by the snapshot endpoint
MAX_SNAPSHOT_CHARS=20000
